flowchart TB
  accTitle: TPP-C&#58; shared/private feature flow → marked timing predictions
  accDescr: TPP-C&#58; shared/private feature flow → marked timing predictions&#59; arrows follow causal inputs to predictions and likelihood contributions.
  past["Past observed snapshots + gaps Available history only"]
  class past input
  encoder["Two causal Transformer summaries Feature state H^x&#59; timing state H^τ"]
  class encoder history
  phys["Current observed physiology x_n&#58; BP, glucose, creatinine"]
  class phys input
  other["Current context q_n Baseline + dynamic covariates Age, masks, staleness, prior mark"]
  class other input
  feature_flow["Invertible feature flow z_n^x = F_x&#40;x_n&#59; H^x&#41;"]
  class feature_flow flow
  split["Partition complete feature latent z_n^x = &#40;u_n, r_n&#41;"]
  class split latent
  shared["Shared coordinates u_n Current timing / mark input"]
  class shared latent
  private["Private coordinates r_n Retained for density + inversion"]
  class private private
  context["Timing / mark context c_n^C = &#91;u_n, q_n, H_n^τ&#93; No direct current r_n input"]
  class context context
  feature_loss["Full feature-snapshot log density log φ_3&#40;&#91;u_n,r_n&#93;&#41; + log &#124;det J_Fx&#124; Added to event + censoring terms"]
  class feature_loss loss
  heads["Conditioning network Mark logits + flow parameters"]
  class heads context
  marks["Mark probabilities π_k = P&#40;m = k &#124; c_n&#41;"]
  class marks output
  timing["One timing flow per mark z = F_τ,k&#40;τ&#59; c_n&#41; f_k&#40;τ&#41;, S_k&#40;τ&#41;"]
  class timing flow
  joint["Joint next-event prediction p&#40;τ, m=k &#124; c_n&#41; = π_k f_k&#40;τ&#41;"]
  class joint output
  mixture["Forecast when the mark is unknown f&#40;τ&#41; = Σ_k π_k f_k&#40;τ&#41; S&#40;τ&#41; = Σ_k π_k S_k&#40;τ&#41;"]
  class mixture output
  event_loss["Observed visit &#40;τ, m&#41; log π_m + log f_m&#40;τ&#41;"]
  class event_loss loss
  censor_loss["Right-censored wait c log S&#40;c&#41; = log Σ_k π_k S_k&#40;c&#41;"]
  class censor_loss loss
  past --> encoder
  phys --> feature_flow
  encoder -->|feature-history state| feature_flow
  feature_flow --> split
  split --> shared
  split --> private
  shared --> context
  other --> context
  encoder -->|timing-history state| context
  shared --> feature_loss
  private --> feature_loss
  feature_flow -->|full flow Jacobian| feature_loss
  context --> heads
  heads --> marks
  heads --> timing
  marks --> joint
  timing --> joint
  joint -->|sum over marks| mixture
  joint -->|known mark| event_loss
  mixture -->|no next mark observed| censor_loss
classDef input fill:#EFF6FF,stroke:#3B82F6,color:#172554
classDef history fill:#F3E8FF,stroke:#8B5CF6,color:#3B0764
classDef flow fill:#FFF7ED,stroke:#F59E0B,color:#78350F
classDef latent fill:#ECFEFF,stroke:#06B6D4,color:#164E63
classDef context fill:#EEF2FF,stroke:#6366F1,color:#312E81
classDef output fill:#ECFDF5,stroke:#10B981,color:#064E3B
classDef loss fill:#FFF1F2,stroke:#F43F5E,color:#881337
classDef private fill:#F1F5F9,stroke:#64748B,color:#334155
