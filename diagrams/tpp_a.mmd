flowchart TB
  accTitle: TPP-A&#58; baseline context → marked timing predictions
  accDescr: TPP-A&#58; baseline context → marked timing predictions&#59; arrows follow causal inputs to predictions and likelihood contributions.
  baseline["Fixed patient baseline s&#58; entry context / covariates"]
  class baseline input
  past["Previous observed IATs τ_1, …, τ_n"]
  class past input
  encoder["Causal Transformer H_n^τ = E&#40;τ_1&#58;n&#41;"]
  class encoder history
  context["Timing / mark context c_n^A = &#91;s, H_n^τ&#93;"]
  class context context
  heads["Conditioning network Mark logits + flow parameters"]
  class heads context
  marks["Mark probabilities π_k = P&#40;m = k &#124; c_n&#41;"]
  class marks output
  timing["One timing flow per mark z = F_τ,k&#40;τ&#59; c_n&#41; f_k&#40;τ&#41;, S_k&#40;τ&#41;"]
  class timing flow
  joint["Joint next-event prediction p&#40;τ, m=k &#124; c_n&#41; = π_k f_k&#40;τ&#41;"]
  class joint output
  mixture["Forecast when the mark is unknown f&#40;τ&#41; = Σ_k π_k f_k&#40;τ&#41; S&#40;τ&#41; = Σ_k π_k S_k&#40;τ&#41;"]
  class mixture output
  event_loss["Observed visit &#40;τ, m&#41; log π_m + log f_m&#40;τ&#41;"]
  class event_loss loss
  censor_loss["Right-censored wait c log S&#40;c&#41; = log Σ_k π_k S_k&#40;c&#41;"]
  class censor_loss loss
  past --> encoder
  baseline --> context
  encoder --> context
  context --> heads
  heads --> marks
  heads --> timing
  marks --> joint
  timing --> joint
  joint -->|sum over marks| mixture
  joint -->|known mark| event_loss
  mixture -->|no next mark observed| censor_loss
classDef input fill:#EFF6FF,stroke:#3B82F6,color:#172554
classDef history fill:#F3E8FF,stroke:#8B5CF6,color:#3B0764
classDef flow fill:#FFF7ED,stroke:#F59E0B,color:#78350F
classDef latent fill:#ECFEFF,stroke:#06B6D4,color:#164E63
classDef context fill:#EEF2FF,stroke:#6366F1,color:#312E81
classDef output fill:#ECFDF5,stroke:#10B981,color:#064E3B
classDef loss fill:#FFF1F2,stroke:#F43F5E,color:#881337
classDef private fill:#F1F5F9,stroke:#64748B,color:#334155
