      "data": {
        "direction": "TB",
        "nodes": [
          {
            "id": "baseline",
            "label": "Patient baseline\ns: entry covariates",
            "class": "input"
          },
          {
            "id": "past",
            "label": "Recorded causal prefix\nEvents / measurements / updates",
            "class": "input"
          },
          {
            "id": "encoder",
            "label": "Common causal Transformer\nH₀ = E(prefix)",
            "class": "history"
          },
          {
            "id": "query",
            "label": "Query age t + feature ID d\nArbitrary, irregular times",
            "class": "input"
          },
          {
            "id": "context",
            "label": "Fixed prefix + query context\ncₜd = [s, H₀, t, e_d]",
            "class": "context"
          },
          {
            "id": "prior",
            "label": "Multi-output GP prior\nf ∼ GP(mθ, kθ)\nLearned mean + PSD cross-feature kernel",
            "class": "latent"
          },
          {
            "id": "observed",
            "label": "Available measurements D\nIrregular (t, d, y) records",
            "class": "input"
          },
          {
            "id": "recognition",
            "label": "Recognition Transformer + MLP\nAvailable (t, d, y) + s, H₀\nAmortised diagonal q(v)",
            "class": "history"
          },
          {
            "id": "latent_future",
            "label": "Sparse variational physiology\nq(f*) from q(v) + GP prior\nFull covariance across query times/features",
            "class": "latent"
          },
          {
            "id": "base_noise",
            "label": "Independent base draws\nzₜd ∼ N(0, 1)",
            "class": "private"
          },
          {
            "id": "residual",
            "label": "Inverse residual flow\nεₜd = Tε⁻¹(zₜd; cₜd)\nNetwork predicts flow parameters",
            "class": "flow"
          },
          {
            "id": "observation",
            "label": "Add physiology + residual\ny* = f* + ε*\nSeparate mean / variance contributions",
            "class": "output"
          },
          {
            "id": "output",
            "label": "Return clinical units\nJoint physiology trajectories\nFull measured-value predictions",
            "class": "output"
          },
          {
            "id": "loss",
            "label": "Train: minimise negative ELBO\n−E_q log pε(y − f) + KL(q(v) ∥ p(v))\nNot an exact marginal NLL",
            "class": "loss"
          }
        ],
        "edges": [
