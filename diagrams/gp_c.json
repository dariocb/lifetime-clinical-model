{
  "version": 2,
  "title": "GP-C: latent physiology GP + independent flow residuals",
  "description": "Input-to-output paths for the implemented GP. Internal values are standardized; forecasts return clinical units. Only available measurements condition a forecast.",
  "diagrams": [
    {
      "id": "gp_c",
