digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55", splines=polyline, fontname="Segoe UI", fontsize=21, fontcolor="#0f172a", labelloc=t, label="GP-C: latent physiology GP + independent flow residuals"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=15, margin="0.18,0.13", penwidth=1.3];
edge [color="#64748b", penwidth=1.35, arrowsize=0.75, fontname="Segoe UI", fontsize=11, fontcolor="#475569"];
baseline [label="Patient baseline\ns: entry covariates", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
past [label="Recorded causal prefix\nEvents / measurements / updates", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
encoder [label="Common causal Transformer\nH₀ = E(prefix)", fillcolor="#F3E8FF", color="#8B5CF6", fontcolor="#3B0764"];
query [label="Query age t + feature ID d\nArbitrary, irregular times", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
context [label="Fixed prefix + query context\ncₜd = [s, H₀, t, e_d]", fillcolor="#EEF2FF", color="#6366F1", fontcolor="#312E81"];
prior [label="Multi-output GP prior\nf ∼ GP(mθ, kθ)\nLearned mean + PSD cross-feature kernel", fillcolor="#ECFEFF", color="#06B6D4", fontcolor="#164E63"];
observed [label="Available measurements D\nIrregular (t, d, y) records", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
recognition [label="Recognition Transformer + MLP\nAvailable (t, d, y) + s, H₀\nAmortised diagonal q(v)", fillcolor="#F3E8FF", color="#8B5CF6", fontcolor="#3B0764"];
latent_future [label="Sparse variational physiology\nq(f*) from q(v) + GP prior\nFull covariance across query times/features", fillcolor="#ECFEFF", color="#06B6D4", fontcolor="#164E63"];
base_noise [label="Independent base draws\nzₜd ∼ N(0, 1)", fillcolor="#F1F5F9", color="#64748B", fontcolor="#334155"];
residual [label="Inverse residual flow\nεₜd = Tε⁻¹(zₜd; cₜd)\nNetwork predicts flow parameters", fillcolor="#FFF7ED", color="#F59E0B", fontcolor="#78350F"];
observation [label="Add physiology + residual\ny* = f* + ε*\nSeparate mean / variance contributions", fillcolor="#ECFDF5", color="#10B981", fontcolor="#064E3B"];
output [label="Return clinical units\nJoint physiology trajectories\nFull measured-value predictions", fillcolor="#ECFDF5", color="#10B981", fontcolor="#064E3B"];
loss [label="Train: minimise negative ELBO\n−E_q log pε(y − f) + KL(q(v) ∥ p(v))\nNot an exact marginal NLL", fillcolor="#FFF1F2", color="#F43F5E", fontcolor="#881337"];
{rank=same; output; loss;}
{rank=same; latent_future; residual;}
past -> encoder [];
baseline -> context [];
encoder -> context [];
query -> context [];
context -> prior [];
observed -> recognition [label="Known observations only"];
encoder -> recognition [];
baseline -> recognition [];
recognition -> latent_future [label="Inducing-variable posterior"];
prior -> latent_future [];
base_noise -> residual [];
context -> residual [label="Condition residual parameters"];
latent_future -> observation [label="Correlated draws f*"];
residual -> observation [label="Independent across records, given context"];
observation -> output [label="Undo training standardisation"];
observed -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
latent_future -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
residual -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
}
