digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55", splines=polyline, fontname="Segoe UI", fontsize=21, fontcolor="#0f172a", labelloc=t, label="GP-A: deep-kernel GP + Gaussian observation noise"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=15, margin="0.18,0.13", penwidth=1.3];
edge [color="#64748b", penwidth=1.35, arrowsize=0.75, fontname="Segoe UI", fontsize=11, fontcolor="#475569"];
baseline [label="Patient baseline\ns: entry covariates", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
past [label="Recorded causal prefix\nEvents / measurements / updates", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
encoder [label="Common causal Transformer\nH₀ = E(prefix)", fillcolor="#F3E8FF", color="#8B5CF6", fontcolor="#3B0764"];
query [label="Query age t + feature ID d\nArbitrary, irregular times", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
context [label="Fixed prefix + query context\ncₜd = [s, H₀, t, e_d]", fillcolor="#EEF2FF", color="#6366F1", fontcolor="#312E81"];
prior [label="Multi-output GP prior\nf ∼ GP(mθ, kθ)\nLearned mean + PSD cross-feature kernel", fillcolor="#ECFEFF", color="#06B6D4", fontcolor="#164E63"];
observed [label="Available measurements D\nIrregular (t, d, y) records", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554"];
posterior [label="Exact Gaussian conditioning\np(f* | D)", fillcolor="#ECFEFF", color="#06B6D4", fontcolor="#164E63"];
noise [label="Independent Gaussian noise\nεG ∼ N(0, Σ)", fillcolor="#F1F5F9", color="#64748B", fontcolor="#334155"];
observation [label="Predictive observation distribution\ny* = f* + εG", fillcolor="#ECFDF5", color="#10B981", fontcolor="#064E3B"];
output [label="Return clinical units\nMean / quantiles / joint samples", fillcolor="#ECFDF5", color="#10B981", fontcolor="#064E3B"];
loss [label="Train: exact marginal NLL\n−log N(y; m, K + Σ)", fillcolor="#FFF1F2", color="#F43F5E", fontcolor="#881337"];
{rank=same; output; loss;}
past -> encoder [];
baseline -> context [];
encoder -> context [];
query -> context [];
context -> prior [];
prior -> posterior [];
observed -> posterior [label="Condition on known y"];
noise -> posterior [label="Noise in conditioning covariance"];
posterior -> observation [label="Joint latent draws f*"];
noise -> observation [label="Future noise"];
observation -> output [label="Undo training standardisation"];
prior -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
observed -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
noise -> loss [style=dashed,style=dashed,constraint=false,color="#e11d48"];
}
